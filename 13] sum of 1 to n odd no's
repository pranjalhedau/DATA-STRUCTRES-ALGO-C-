//SUM OF N ODD  NUM

#include<iostream>
using namespace std;
int main (){
    int n;
    cout << "Enter number N : ";
    cin >> n;
    int sum=0;
    for (int i=0;i<=n;i++){
        if(i%2 != 0){
          sum = sum + i;
        }
  }
    cout <<"The sum of n numbers : " << sum << "\n";
    return 0;
  }
