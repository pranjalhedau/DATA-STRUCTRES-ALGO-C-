//PRINT SQUARE PATTERN (number continues)

#include<iostream>
using namespace std;
int main(){
    int n;
    cout << "Enter n : ";
    cin >> n;
    int num = 1;
    int i,j;
    for(i=1;i<=n;i++){
        for(j=1;j<=n;j++){
            cout << num << " " ;
            num ++;
        }
        cout << endl;
    }
    return 0;
}
