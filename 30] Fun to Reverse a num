// Write a fun to reverse a integer n 

#include<iostream>
using namespace std;

int reversenum(int n) {
    int rev = 0;
    
    while ( n> 0){
    int lastdig = n % 10;
    rev = rev * 10 + lastdig;
    n = n/10;
    }
    return rev;
}
int main(){
    int n;
    cout << "Enter n : ";
    cin >> n;
    cout<< reversenum(n) << "\n";
}
