//TO CHK WHETHER NO IS PRIME OR NOT 

#include<iostream>
using namespace std;
int main(){
    int n=14, i;
    bool isprime=true;
    for(i=2;i<n;i++){
        if(n%i==0){
            isprime = false;
            break;
        }
    }
if(isprime==false){
    cout<<"Not prime";
}
else{
    cout<<"prime";
}
return 0;
}
